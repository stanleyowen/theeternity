# Copy to .env for local development, or set these as real environment variables.

# production | development (development shows stack traces)
APP_ENV=production

# true  = read-only archive showcase (default): no writes, demo dashboard access
# false = fully working site (registration, scrims, uploads, messages)
ARCHIVE_MODE=true

# 32 random bytes, base64. Generate with:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Used for AES-256-GCM encryption of contact-form data. If unset, one is generated in storage/.app_key
APP_KEY=

# Database. Defaults to SQLite at storage/database/eternity.sqlite
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=eternity;charset=utf8mb4
# DB_USER=eternity
# DB_PASS=

# Set to true only when running behind a reverse proxy that sets X-Forwarded-Proto
TRUST_PROXY=false
