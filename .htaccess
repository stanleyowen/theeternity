# Shared-hosting fallback (the Docker image uses docker/apache.conf instead).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bin|database|docker|storage)(/|$) - [R=404,L]
    RewriteRule (^|/)\. - [R=404,L]
</IfModule>

<FilesMatch "^\.|\.(sql|sqlite|md|sh|ini|lock|example|yml|yaml|log)$">
    Require all denied
</FilesMatch>

ErrorDocument 403 /global-error/403.php
ErrorDocument 404 /global-error/404.php
ErrorDocument 500 /global-error/500.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>
